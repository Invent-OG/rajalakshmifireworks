---
import StoreLayout from '@/src/layouts/StoreLayout.astro';
import {
  getCachedCategories,
  getCachedAllActiveProducts,
  getCachedSettingsMap,
} from '@/lib/cache/catalog-cache';
import { QuickOrderContent } from '@/components/store/quick-order-content';
import { isValidLocale } from '@/lib/i18n/config';
import { getTranslations } from '@/lib/i18n/server';
import { APP_CONFIG } from '@/lib/constants/config';

const { locale = 'en' } = Astro.params;
if (!isValidLocale(locale)) {
  return Astro.redirect('/en/quick-order');
}

// Edge & Browser Cache: 30s fresh, 120s stale-while-revalidate
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=30, stale-while-revalidate=120'
);

// Fetch cached categories, products, and store settings in parallel (< 0.5ms)
const [categoriesData, allProducts, settingsMap] = await Promise.all([
  getCachedCategories(),
  getCachedAllActiveProducts(),
  getCachedSettingsMap(),
]);

// Sort products by sellingPrice ASC, then name
const productsData = [...allProducts].sort((a, b) => {
  const pA = Number(a.sellingPrice || 0);
  const pB = Number(b.sellingPrice || 0);
  if (pA !== pB) return pA - pB;
  return (a.name || '').localeCompare(b.name || '');
});

// Store settings for min order value
let minOrderValue = 2000;
const minOrderValStr = settingsMap.get('MIN_ORDER_VALUE');
if (minOrderValStr) {
  const parsed = parseInt(minOrderValStr, 10);
  if (!isNaN(parsed) && parsed > 0) minOrderValue = parsed;
}

const tNav = getTranslations(locale, 'navigation');
---

<StoreLayout
  title={`${tNav('quickOrder')} | ${APP_CONFIG.STORE_NAME}`}
  description={`Instant Diwali fireworks wholesale table and bulk order catalog from ${APP_CONFIG.STORE_NAME}, Sivakasi. Add cracker quantities directly and checkout quickly.`}
  locale={locale}
>
  <main class="w-full">
    <QuickOrderContent
      client:load
      products={productsData as any}
      categories={categoriesData as any}
      minOrderValue={minOrderValue}
      locale={locale as any}
    />
  </main>
</StoreLayout>
