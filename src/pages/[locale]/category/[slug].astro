---
import { isValidLocale } from '@/lib/i18n/config';

const { locale = 'en', slug } = Astro.params;
const targetLocale = isValidLocale(locale) ? locale : 'en';

if (!slug) {
  return Astro.redirect(`/${targetLocale}/products`);
}

const search = Astro.url.search || '';
const cleanSearch = search ? (search.startsWith('?') ? `&${search.slice(1)}` : `&${search}`) : '';
return Astro.redirect(`/${targetLocale}/products?category=${slug}${cleanSearch}`);
---
