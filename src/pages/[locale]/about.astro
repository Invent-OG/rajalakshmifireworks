---
import StoreLayout from '@/src/layouts/StoreLayout.astro';
import { AboutContent } from '@/components/store/about-content';
import { isValidLocale } from '@/lib/i18n/config';
import { APP_CONFIG } from '@/lib/constants/config';

const { locale = 'en' } = Astro.params;
if (!isValidLocale(locale)) {
  return Astro.redirect('/en/about');
}

const pageTitle = locale === 'ta'
  ? `ராஜலக்ஷ்மி பட்டாசு பற்றி | ${APP_CONFIG.STORE_NAME}`
  : `About Us | ${APP_CONFIG.STORE_NAME} - Sivakasi Direct Green Fireworks`;

const pageDescription = locale === 'ta'
  ? 'ராஜலக்ஷ்மி பட்டாசு - சிவகாசியின் 30 ஆண்டுகால பாரம்பரிய பட்டாசு உற்பத்தியாளர். CSIR-NEERI சான்றளிக்கப்பட்ட 100% பசுமை பட்டாசுகள், நேரடி மொத்த விலை மற்றும் பாதுகாப்பான பார்சல் போக்குவரத்து.'
  : 'Learn about Rajalakshmi Fireworks, Sivakasi. Over 30 years of manufacturing excellence in CSIR-NEERI certified green crackers, direct factory pricing, and nationwide parcel dispatch.';
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
>
  <main class="w-full">
    <AboutContent client:load />
  </main>
</StoreLayout>
