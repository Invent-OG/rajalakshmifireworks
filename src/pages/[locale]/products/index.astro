---
import StoreLayout from '@/src/layouts/StoreLayout.astro';
import {
  getCachedCategories,
  getCachedAllActiveProducts,
} from '@/lib/cache/catalog-cache';
import { ProductCard } from '@/components/store/product-card';
import { ProductsCatalogToolbar } from '@/components/store/products-catalog-toolbar';
import { EmptyState } from '@/components/ui/empty-state';
import { QuickCartSidebar } from '@/components/store/quick-cart-drawer';
import { SectionTag } from '@/components/ui/section-tag';
import { Filter } from 'lucide-react';
import { isValidLocale } from '@/lib/i18n/config';
import { getTranslations } from '@/lib/i18n/server';
import { getLocalizedName } from '@/lib/i18n/formatters';

import { GET as apiGet } from '@/src/pages/api/products';

const { locale = 'en' } = Astro.params;
if (locale === 'api') {
  return apiGet(Astro);
}
if (!isValidLocale(locale)) {
  return Astro.redirect('/en');
}

// Edge & Browser Cache: 30s fresh, 120s stale-while-revalidate
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=30, stale-while-revalidate=120'
);

const url = Astro.url;
const search = url.searchParams.get('search') || '';
const sort = url.searchParams.get('sort') || 'newest';
const isCombos = url.searchParams.get('combos') === 'true' || url.searchParams.get('combo') === 'true';
const featured = isCombos || url.searchParams.get('featured') === 'true';
const bestseller = url.searchParams.get('bestseller') === 'true';
const categorySlug = url.searchParams.get('category') || '';

// Fetch all active categories & products from in-memory cache (< 0.2ms)
const [categoryList, allActiveProducts] = await Promise.all([
  getCachedCategories(),
  getCachedAllActiveProducts(),
]);

// Compute counts instantly from memory
const totalActiveCount = allActiveProducts.length;
const categoryCountMap = new Map<number, number>();
let comboTotalCount = 0;
let bestsellerTotalCount = 0;

for (const p of allActiveProducts) {
  if (p.categoryId) {
    categoryCountMap.set(p.categoryId, (categoryCountMap.get(p.categoryId) || 0) + 1);
  }
  const isComboItem = Boolean(
    p.isCombo ||
    p.isFeatured ||
    (p.name && /combo|gift/i.test(p.name))
  );
  if (isComboItem) comboTotalCount++;
  if (p.isBestseller) bestsellerTotalCount++;
}

// Active category if category filter is set
let activeCategory: { id: number; name: string; nameTa?: string | null } | undefined;
if (categorySlug) {
  activeCategory = categoryList.find((c) => c.slug === categorySlug);
}

// Filter products in memory
let filtered = allActiveProducts;

if (search.trim()) {
  const query = search.trim().toLowerCase();
  filtered = filtered.filter((p) => {
    return (
      (p.name && p.name.toLowerCase().includes(query)) ||
      (p.nameTa && p.nameTa.toLowerCase().includes(query)) ||
      (p.description && p.description.toLowerCase().includes(query)) ||
      (p.descriptionTa && p.descriptionTa.toLowerCase().includes(query))
    );
  });
}

if (isCombos) {
  filtered = filtered.filter((p) =>
    Boolean(p.isCombo || p.isFeatured || (p.name && /combo|gift/i.test(p.name)))
  );
} else if (featured) {
  filtered = filtered.filter((p) => Boolean(p.isFeatured));
}

if (bestseller) {
  filtered = filtered.filter((p) => Boolean(p.isBestseller));
}

if (activeCategory) {
  filtered = filtered.filter((p) => p.categoryId === activeCategory!.id);
}

// Sort in memory
const productList = [...filtered].sort((a, b) => {
  switch (sort) {
    case 'price_asc':
      return Number(a.sellingPrice || 0) - Number(b.sellingPrice || 0);
    case 'price_desc':
      return Number(b.sellingPrice || 0) - Number(a.sellingPrice || 0);
    case 'name_asc': {
      const nameA = locale === 'ta' && a.nameTa ? a.nameTa : (a.name || '');
      const nameB = locale === 'ta' && b.nameTa ? b.nameTa : (b.name || '');
      return nameA.localeCompare(nameB);
    }
    default:
      return new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime();
  }
});

const tNav = getTranslations(locale, 'navigation');
const tProd = getTranslations(locale, 'products');
const tCat = getTranslations(locale, 'categories');
const tFilters = getTranslations(locale, 'filters');
const tCommon = getTranslations(locale, 'common');

const pageHeading = activeCategory
  ? getLocalizedName(activeCategory, locale)
  : featured
    ? tNav('combos')
    : bestseller
      ? (locale === 'ta' ? 'அதிகம் விற்பனையான பட்டாசுகள்' : 'Festive Bestsellers')
      : search
        ? `${locale === 'ta' ? 'தேடல் முடிவுகள்:' : 'Results for'} "${search}"`
        : (locale === 'ta' ? 'பிரீமியம் பட்டாசுகள்' : 'Premium Fireworks');

const getHref = (path: string) => (locale === 'en' ? path : `/${locale}${path}`);
---

<StoreLayout title={`${pageHeading} | Rajalakshmi Fireworks`} locale={locale}>
  <div class="w-full px-3 sm:px-6 lg:px-10 py-4 sm:py-8 animate-fade-in space-y-4 sm:space-y-6 font-sans">
    {/* ── Centered Header Title (Matches Screenshot) ── */}
    <div class="text-center pt-1 pb-1 sm:pt-2">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight">
        {pageHeading}
      </h1>
    </div>

    {/* ── Horizontal Scrolling Category Pills with Live Product Counts (Matches Screenshot) ── */}
    <div class="flex gap-2 sm:gap-2.5 overflow-x-auto no-scrollbar py-1 -mx-3 px-3 sm:mx-0 sm:px-0 select-none items-center">
      <a
        href={getHref('/products')}
        class={`px-4 py-2 sm:py-2.5 rounded-full text-xs font-bold shrink-0 transition-all flex items-center gap-2 ${
          !categorySlug && !featured && !bestseller
            ? 'bg-amber-400 text-neutral-950 shadow-xs ring-1 ring-amber-500/30'
            : 'bg-white dark:bg-[#141414] text-neutral-700 dark:text-neutral-200 border border-neutral-200/90 dark:border-[#282828] hover:bg-neutral-50 dark:hover:bg-[#1a1a1a] shadow-2xs'
        }`}
      >
        <span>{tCommon('all')} {tNav('allProducts')}</span>
        <span
          class={`text-[11px] px-2 py-0.5 rounded-full font-bold ${
            !categorySlug && !featured && !bestseller
              ? 'bg-black/15 text-neutral-950'
              : 'bg-neutral-100 dark:bg-[#202020] text-neutral-500 dark:text-neutral-400'
          }`}
        >
          {totalActiveCount}
        </span>
      </a>

      {/* Combos Pill */}
      {comboTotalCount > 0 && (
        <a
          href={getHref('/products?combos=true')}
          class={`px-4 py-2 sm:py-2.5 rounded-full text-xs font-bold shrink-0 transition-all flex items-center gap-2 ${
            isCombos || featured
              ? 'bg-amber-400 text-neutral-950 shadow-xs ring-1 ring-amber-500/30'
              : 'bg-white dark:bg-[#141414] text-neutral-700 dark:text-neutral-200 border border-neutral-200/90 dark:border-[#282828] hover:bg-neutral-50 dark:hover:bg-[#1a1a1a] shadow-2xs'
          }`}
        >
          <span>{tNav('combos')}</span>
          <span
            class={`text-[11px] px-2 py-0.5 rounded-full font-bold ${
              isCombos || featured
                ? 'bg-black/15 text-neutral-950'
                : 'bg-neutral-100 dark:bg-[#202020] text-neutral-500 dark:text-neutral-400'
            }`}
          >
            {comboTotalCount}
          </span>
        </a>
      )}

      {/* Bestseller Pill */}
      {bestsellerTotalCount > 0 && (
        <a
          href={getHref('/products?bestseller=true')}
          class={`px-4 py-2 sm:py-2.5 rounded-full text-xs font-bold shrink-0 transition-all flex items-center gap-2 ${
            bestseller
              ? 'bg-amber-400 text-neutral-950 shadow-xs ring-1 ring-amber-500/30'
              : 'bg-white dark:bg-[#141414] text-neutral-700 dark:text-neutral-200 border border-neutral-200/90 dark:border-[#282828] hover:bg-neutral-50 dark:hover:bg-[#1a1a1a] shadow-2xs'
          }`}
        >
          <span>{tProd('bestseller')}</span>
          <span
            class={`text-[11px] px-2 py-0.5 rounded-full font-bold ${
              bestseller
                ? 'bg-black/15 text-neutral-950'
                : 'bg-neutral-100 dark:bg-[#202020] text-neutral-500 dark:text-neutral-400'
            }`}
          >
            {bestsellerTotalCount}
          </span>
        </a>
      )}

      {/* Categories */}
      {categoryList.map((cat) => {
        const isSelected = categorySlug === cat.slug;
        const count = categoryCountMap.get(cat.id) || 0;
        return (
          <a
            href={getHref(`/products?category=${cat.slug}`)}
            class={`px-4 py-2 sm:py-2.5 rounded-full text-xs font-bold shrink-0 transition-all flex items-center gap-2 ${
              isSelected
                ? 'bg-amber-400 text-neutral-950 shadow-xs ring-1 ring-amber-500/30'
                : 'bg-white dark:bg-[#141414] text-neutral-700 dark:text-neutral-200 border border-neutral-200/90 dark:border-[#282828] hover:bg-neutral-50 dark:hover:bg-[#1a1a1a] shadow-2xs'
            }`}
          >
            <span>{getLocalizedName(cat, locale)}</span>
            <span
              class={`text-[11px] px-2 py-0.5 rounded-full font-bold ${
                isSelected
                  ? 'bg-black/15 text-neutral-950'
                  : 'bg-neutral-100 dark:bg-[#202020] text-neutral-500 dark:text-neutral-400'
              }`}
            >
              {count}
            </span>
          </a>
        );
      })}
    </div>

    {/* ── Compact Controls Toolbar: Search + Sort Dropdown + View Toggle (Matches Screenshot) ── */}
    <div>
      <ProductsCatalogToolbar
        client:load
        currentSort={sort}
        initialSearch={search}
        placeholder={locale === 'ta' ? 'பட்டாசுகளைத் தேடுங்கள்...' : 'Search fireworks...'}
      />
      <div class="border-b border-neutral-200/80 dark:border-[#282828] mt-3" />
    </div>

    {/* Main Catalog View: Category Sidebar + Product Grid + Quick Cart Widget */}
    <div class="flex gap-6 items-start">
      {/* Desktop Category Sidebar */}
      <aside class="hidden lg:block w-56 shrink-0 bg-white dark:bg-[#141414] dark:border dark:border-[#282828] rounded-[28px] sm:rounded-[32px] p-5 sticky top-24 shadow-sm dark:shadow-none">
        <div class="flex items-center gap-2 pb-3 mb-3 border-b border-neutral-100 dark:border-[#282828] font-bold text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          <Filter className="h-3.5 w-3.5 text-brand" />
          <span>{tCat('title')}</span>
        </div>

        <ul class="space-y-1.5">
          <li>
            <a
              href={getHref('/products')}
              class={`flex items-center justify-between px-3.5 py-2 rounded-full text-xs font-semibold transition-all ${
                !categorySlug && !featured && !bestseller
                  ? 'bg-neutral-900 text-white dark:bg-white dark:text-black shadow-xs'
                  : 'text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-[#202020] hover:text-neutral-900 dark:hover:text-white'
              }`}
            >
              <span>{tNav('allProducts')}</span>
              <span class="text-[11px] opacity-75">{totalActiveCount}</span>
            </a>
          </li>
          <li>
            <a
              href={getHref('/products?combos=true')}
              class={`flex items-center justify-between px-3.5 py-2 rounded-full text-xs font-semibold transition-all ${
                isCombos || featured
                  ? 'bg-neutral-900 text-white dark:bg-white dark:text-black shadow-xs'
                  : 'text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-[#202020] hover:text-neutral-900 dark:hover:text-white'
              }`}
            >
              <span>{tNav('combos')}</span>
              <span class="text-[11px] opacity-75">{comboTotalCount}</span>
            </a>
          </li>
          <li>
            <a
              href={getHref('/products?bestseller=true')}
              class={`flex items-center justify-between px-3.5 py-2 rounded-full text-xs font-semibold transition-all ${
                bestseller
                  ? 'bg-neutral-900 text-white dark:bg-white dark:text-black shadow-xs'
                  : 'text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-[#202020] hover:text-neutral-900 dark:hover:text-white'
              }`}
            >
              <span>{tProd('bestseller')}</span>
              <span class="text-[11px] opacity-75">{bestsellerTotalCount}</span>
            </a>
          </li>

          <li class="pt-2 pb-1 border-t border-neutral-100 dark:border-[#282828] my-2 text-[10px] uppercase font-bold text-neutral-400 tracking-wider px-3">
            {tCat('title')}
          </li>

          {categoryList.map((cat) => (
            <li>
              <a
                href={getHref(`/products?category=${cat.slug}`)}
                class={`flex items-center justify-between px-3.5 py-2 rounded-full text-xs font-semibold transition-all ${
                  categorySlug === cat.slug
                    ? 'bg-neutral-900 text-white dark:bg-white dark:text-black shadow-xs'
                    : 'text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-[#202020] hover:text-neutral-900 dark:hover:text-white'
                }`}
              >
                <span>{getLocalizedName(cat, locale)}</span>
                <span class="text-[11px] opacity-75">{categoryCountMap.get(cat.id) || 0}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>

      {/* Product Grid Area */}
      <div class="flex-1 min-w-0">
        {productList.length > 0 ? (
          <div
            id="products-grid-container"
            class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-3 sm:gap-4"
          >
            {productList.map((product) => (
              <ProductCard client:visible product={product} />
            ))}
          </div>
        ) : (
          <EmptyState
            client:load
            title={tProd('noProducts')}
            description={
              search
                ? (locale === 'ta'
                    ? `"${search}" என்ற தேடலுக்கு பட்டாசுகள் எதுவும் கிடைக்கவில்லை.`
                    : `We couldn't find any crackers matching "${search}".`)
                : (locale === 'ta'
                    ? 'இப்பிரிவில் தற்போது பட்டாசுகள் எதுவும் பட்டியலிடப்படவில்லை.'
                    : 'There are currently no crackers listed in this category.')
            }
            actionLabel={tNav('allProducts')}
            actionHref={getHref('/products')}
          />
        )}
      </div>

      {/* Desktop Quick Cart Widget */}
      <QuickCartSidebar client:load />
    </div>
  </div>
</StoreLayout>
