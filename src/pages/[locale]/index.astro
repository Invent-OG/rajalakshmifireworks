---
import StoreLayout from "@/src/layouts/StoreLayout.astro";
import {
  getCachedCategories,
  getCachedHomeProducts,
} from "@/lib/cache/catalog-cache";
import { FeaturedProductsSlider } from "@/components/store/featured-products-slider";
import { HomeMotion } from "@/components/store/home-motion";
import { OrganicCategoriesGrid } from "@/components/store/organic-categories-grid";
import { Testimonial02Blaze } from "@/components/sections/testimonial-02-blaze";
import { InfiniteRibbonPreview } from "@/components/ui/infinite-ribbon-demo";
import { DiwaliCountdownBanner } from "@/components/store/diwali-countdown-banner";
import { isValidLocale } from "@/lib/i18n/config";
import { getTranslations } from "@/lib/i18n/server";
import DiwaliHero from "@/components/store/DiwaliHero.astro";

const { locale = "en" } = Astro.params;
if (!isValidLocale(locale)) {
  return Astro.redirect("/en");
}

// Edge & Browser Cache: 30s fresh, 120s stale-while-revalidate
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=30, stale-while-revalidate=120",
);

let allCategories: any[] = [];
let allActiveProducts: any[] = [];

try {
  const [cats, prods] = await Promise.all([
    getCachedCategories(),
    getCachedHomeProducts(),
  ]);
  allCategories = cats || [];
  allActiveProducts = prods || [];
} catch (err) {
  console.error('[index.astro] Error loading catalog data:', err);
}

const categoryList = (allCategories || []).slice(0, 8);
const featuredProducts = (allActiveProducts || [])
  .filter((p) => p?.isFeatured)
  .slice(0, 12);
const bestsellerProducts = (allActiveProducts || [])
  .filter((p) => p?.isBestseller)
  .slice(0, 12);

const tSeo = getTranslations(locale, "seo");
---

<StoreLayout
  title={tSeo("defaultTitle")}
  description={tSeo("defaultDescription")}
  locale={locale}
  containerClass="home-page-gradient relative"
  headerOverlay={true}
>
  <!-- Static ambient color keeps the background decorative without a full-screen WebGL render loop. -->
  <div
    class="home-ambient fixed inset-0 pointer-events-none z-0 overflow-hidden hidden md:block"
    aria-hidden="true"
  ></div>
  <HomeMotion client:idle>
    <DiwaliHero />
    <div
      class="relative z-10 w-full space-y-6 sm:space-y-12 md:space-y-[50px] pb-12 overflow-hidden font-sans"
    >
      {/* ── Diwali Live Countdown Banner ─── */}
      <!-- <section class="reveal-section py-5 w-full">
        <DiwaliCountdownBanner client:load />
      </section> -->

      {/* ── Infinite Ribbon Ticker ─── */}
      <section class="reveal-section w-full overflow-hidden rounded-b-[32px] bg-[#0b0606]">
        <InfiniteRibbonPreview client:visible />
        <OrganicCategoriesGrid client:visible categories={categoryList} locale={locale as any} />
      </section>

      {/* ── 2. Live Fireworks Categories Bento Discovery Grid ─── */}
      <section class="reveal-section w-full"></section>

      <!-- 
      {/* ── 1. Hero Section ─── */}
      <section class="reveal-section w-full">
        <OrganicHero client:load initialConfig={heroConfig} />
      </section> -->

      {/* ── 4. Festive Bestsellers Slider ─── */}
      {
        bestsellerProducts.length > 0 && (
          <section class="reveal-section w-full">
            <FeaturedProductsSlider
              client:idle
              products={bestsellerProducts}
              locale={locale as any}
              title={
                locale === "ta"
                  ? "அதிகம் விற்பனையான பட்டாசுகள்"
                  : "Festive Bestsellers"
              }
              subtitle={
                locale === "ta"
                  ? "தமிழ்நாடு மற்றும் தென் இந்தியா முழுவதும் வாடிக்கையாளர்களால் அதிகம் விரும்பப்பட்ட சிறந்த பட்டாசுகள்."
                  : "The most demanded celebration fireworks across Tamil Nadu & South India, packaged fresh from Sivakasi workshops."
              }
              tagLabel={
                locale === "ta"
                  ? "வாடிக்கையாளர் விருப்பம்"
                  : "Customer Favorites"
              }
              viewAllHref={
                locale === "en"
                  ? "/products?bestseller=true"
                  : `/${locale}/products?bestseller=true`
              }
              viewAllLabel={
                locale === "ta" ? "அனைத்தையும் பார்க்க" : "View All Bestsellers"
              }
              scrollDrift="left"
            />
          </section>
        )
      }

      {/* ── 3. Featured Products Slider ─── */}
      {
        featuredProducts.length > 0 && (
          <section class="reveal-section w-full">
            <FeaturedProductsSlider
              client:idle
              products={featuredProducts}
              locale={locale as any}
              title={
                locale === "ta"
                  ? "சிறப்பு பட்டாசு ரகங்கள்"
                  : "Featured Fireworks"
              }
              subtitle={
                locale === "ta"
                  ? "கம்பி மத்தாப்புகள், வான்வெளி வெடிகள் மற்றும் வண்ணமயமான பவுண்டன்களின் தேர்ந்தெடுக்கப்பட்ட சிறப்பு தொகுப்பு."
                  : "Hand-selected aerial cakes, vibrant flower pots, and family combo boxes tested for maximum sparkle."
              }
              tagLabel={
                locale === "ta" ? "சிறப்பு தொகுப்பு" : "Curated Masterpieces"
              }
              viewAllHref={
                locale === "en"
                  ? "/products?featured=true"
                  : `/${locale}/products?featured=true`
              }
              viewAllLabel={
                locale === "ta" ? "அனைத்தையும் பார்க்க" : "View All Featured"
              }
              scrollDrift="right"
            />
          </section>
        )
      }

      {/* ── 5. Testimonial 02 Blaze ─── */}
      <section class="reveal-section w-full">
        <Testimonial02Blaze client:visible />
      </section>
    </div>
  </HomeMotion>
</StoreLayout>

<style is:global>
  .home-ambient {
    background:
      radial-gradient(ellipse at 18% 25%, rgba(226, 64, 0, 0.1), transparent 42%),
      radial-gradient(ellipse at 82% 18%, rgba(251, 146, 60, 0.1), transparent 38%);
  }
</style>
