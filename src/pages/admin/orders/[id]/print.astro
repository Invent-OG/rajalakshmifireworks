---
import RootLayout from '@/src/layouts/RootLayout.astro';
import { db } from '@/db';
import { orders } from '@/db/schema';
import { eq } from 'drizzle-orm';
import { formatCurrency, formatDateTime, toNumber } from '@/lib/utils/format';
import { APP_CONFIG } from '@/lib/constants/config';
import { PrintButton } from '@/components/admin/print-button';

const { id } = Astro.params;
const orderId = parseInt(id as string, 10);

if (isNaN(orderId)) {
  return Astro.redirect('/admin/orders');
}

const order = await db.query.orders.findFirst({
  where: eq(orders.id, orderId),
  with: {
    items: true,
    customer: true,
  },
});

if (!order) {
  return Astro.redirect('/admin/orders');
}

const address = order.addressSnapshot as {
  address: string;
  city: string;
  pincode: string;
} | null;
---

<RootLayout title={`Print Order #${order.invoiceNumber} | Rajalakshmi Fireworks`}>
  <div class="min-h-screen bg-white text-black p-6 sm:p-10 font-sans print:p-0 print:m-0">
    <div class="max-w-3xl mx-auto space-y-6">
      {/* Actions bar (Hidden in print) */}
      <div class="flex items-center justify-between pb-4 border-b border-gray-200 print:hidden">
        <a
          href={`/admin/orders/${order.id}`}
          class="text-xs text-gray-600 hover:text-black font-medium underline"
        >
          ← Back to Order #{order.invoiceNumber}
        </a>
        <PrintButton client:load />
      </div>

      {/* Invoice Container for Print */}
      <div class="border border-gray-300 p-8 rounded-xl shadow-xs print:border-none print:p-0 print:shadow-none space-y-6">
        {/* Header */}
        <div class="flex items-start justify-between border-b pb-6 border-gray-200">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 uppercase">
              {APP_CONFIG.STORE_NAME}
            </h1>
            <p class="text-xs text-gray-500 mt-1">{APP_CONFIG.STORE_TAGLINE}</p>
            <p class="text-xs text-gray-500">Sivakasi, Tamil Nadu, India</p>
            <p class="text-xs text-gray-500">Contact: {APP_CONFIG.STORE_PHONE}</p>
          </div>
          <div class="text-right">
            <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-800 rounded-sm mb-2 uppercase tracking-wider">
              ESTIMATE / DISPATCH MEMO
            </span>
            <p class="text-sm font-bold text-gray-900">
              #{order.invoiceNumber}
            </p>
            <p class="text-xs text-gray-500 mt-0.5">
              Date: {formatDateTime(order.placedAt)}
            </p>
          </div>
        </div>

        {/* Customer & Fulfillment Info */}
        <div class="grid grid-cols-2 gap-6 text-xs border-b pb-6 border-gray-200">
          <div>
            <h3 class="font-bold text-gray-900 mb-1.5 uppercase tracking-wider text-[11px] text-gray-400">
              Customer Details
            </h3>
            <p class="font-semibold text-gray-900 text-sm">
              {order.customerNameSnapshot}
            </p>
            <p class="text-gray-600 mt-0.5">{order.customerMobileSnapshot}</p>
            {order.customer?.email && (
              <p class="text-gray-600">{order.customer.email}</p>
            )}
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1.5 uppercase tracking-wider text-[11px] text-gray-400">
              Delivery / Transport Details
            </h3>
            <p class="font-medium text-gray-800">
              Type: <span class="capitalize">{order.fulfillmentType.replace('_', ' ')}</span>
            </p>
            {address ? (
              <div class="text-gray-600 mt-1">
                <p>{address.address}</p>
                <p>
                  {address.city} - {address.pincode}
                </p>
              </div>
            ) : (
              <p class="text-gray-500 italic mt-1">Direct store pickup / Sivakasi Depot</p>
            )}
          </div>
        </div>

        {/* Items Table */}
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-gray-200 text-gray-500 uppercase tracking-wider text-[10px]">
                <th class="py-2.5 font-bold">#</th>
                <th class="py-2.5 font-bold">Product Name</th>
                <th class="py-2.5 font-bold text-center">Qty</th>
                <th class="py-2.5 font-bold text-right">Unit Rate</th>
                <th class="py-2.5 font-bold text-right">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {order.items.map((item, index) => (
                <tr>
                  <td class="py-2 text-gray-400 font-mono text-[11px]">{index + 1}</td>
                  <td class="py-2 font-medium text-gray-900">{item.productNameSnapshot}</td>
                  <td class="py-2 text-center font-bold text-gray-800 font-mono">{item.quantity}</td>
                  <td class="py-2 text-right text-gray-600 font-mono">
                    {formatCurrency(item.sellingPriceSnapshot)}
                  </td>
                  <td class="py-2 text-right font-medium text-gray-900 font-mono">
                    {formatCurrency(item.lineTotal)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Totals Calculation */}
        <div class="border-t pt-4 border-gray-200">
          <div class="w-64 ml-auto space-y-1.5 text-xs">
            <div class="flex justify-between text-gray-600">
              <span>Subtotal:</span>
              <span class="font-mono">{formatCurrency(order.subtotal)}</span>
            </div>
            {toNumber(order.discountAmount) > 0 && (
              <div class="flex justify-between text-green-700">
                <span>Discount / Savings:</span>
                <span class="font-mono">-{formatCurrency(order.discountAmount)}</span>
              </div>
            )}
            {toNumber(order.deliveryCharge) > 0 && (
              <div class="flex justify-between text-gray-600">
                <span>Transport / Packaging:</span>
                <span class="font-mono">+{formatCurrency(order.deliveryCharge)}</span>
              </div>
            )}
            <div class="flex justify-between font-bold text-sm text-gray-900 border-t pt-2 border-gray-200">
              <span>Total Amount:</span>
              <span class="font-mono">{formatCurrency(order.totalAmount)}</span>
            </div>
          </div>
        </div>

        {/* Packing / Quality Check Signatures */}
        <div class="grid grid-cols-3 gap-6 pt-12 text-center text-xs text-gray-400">
          <div class="border-t border-dashed border-gray-300 pt-2">
            <span>Prepared By</span>
          </div>
          <div class="border-t border-dashed border-gray-300 pt-2">
            <span>Verified & Packed By</span>
          </div>
          <div class="border-t border-dashed border-gray-300 pt-2">
            <span>Customer Sign / Seal</span>
          </div>
        </div>

        {/* Legal / Notice */}
        <div class="text-[10px] text-gray-400 text-center pt-4 border-t border-gray-100">
          <p>This is a computer generated invoice/dispatch memo. All products conform to Sivakasi fireworks safety standards.</p>
        </div>
      </div>
    </div>
  </div>
</RootLayout>
