---
import AdminLayout from '@/src/layouts/AdminLayout.astro';
import CustomerDetailPage from '@/app/admin/customers/[id]/page';

const { id } = Astro.params;
const paramsPromise = Promise.resolve({ id: id as string });
---

<AdminLayout title={`Customer Details #${id} | Rajalakshmi Fireworks`}>
  <CustomerDetailPage client:only="react" params={paramsPromise} />
</AdminLayout>
