---
const { slug } = Astro.params;
const cookieLocale = Astro.cookies.get('NEXT_LOCALE')?.value;
const locale = cookieLocale === 'ta' ? 'ta' : 'en';
const search = Astro.url.search || '';
const cleanSearch = search ? (search.startsWith('?') ? `&${search.slice(1)}` : `&${search}`) : '';
return Astro.redirect(`/${locale}/products?category=${slug}${cleanSearch}`);
---
