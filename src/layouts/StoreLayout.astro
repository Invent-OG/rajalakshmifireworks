---
import RootLayout from './RootLayout.astro';
import { StoreHeader } from '@/components/store/store-header';
import { StoreFooter } from '@/components/store/store-footer';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  locale?: string;
}

const { title, description, keywords, locale = 'en' } = Astro.props;
---

<RootLayout title={title} description={description} keywords={keywords} locale={locale}>
  <div class="min-h-screen flex flex-col bg-background text-foreground">
    <StoreHeader client:load />
    <main class="flex-1 pb-12 md:pb-6">
      <slot />
    </main>
    <StoreFooter client:load />
  </div>
</RootLayout>

