---
import RootLayout from './RootLayout.astro';
import { StoreHeader } from '@/components/store/store-header';
import { StoreFooter } from '@/components/store/store-footer';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  locale?: string;
  containerClass?: string;
  bodyClass?: string;
}

const { title, description, keywords, locale = 'en', containerClass, bodyClass } = Astro.props;
const pathname = Astro.url.pathname;
---

<RootLayout
  title={title}
  description={description}
  keywords={keywords}
  locale={locale}
  bodyClass={bodyClass || (containerClass ? containerClass : 'bg-background')}
>
  <div class:list={['min-h-screen flex flex-col text-foreground', containerClass || 'bg-background']}>
    <StoreHeader client:load pathname={pathname} locale={locale} />
    <main class="flex-1 pb-12 md:pb-6">
      <slot />
    </main>
    <StoreFooter client:load pathname={pathname} locale={locale} />
  </div>
</RootLayout>

