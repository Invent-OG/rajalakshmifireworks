---
import RootLayout from './RootLayout.astro';
import { StoreHeader } from '@/components/store/store-header';
import { StoreFooter } from '@/components/store/store-footer';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  locale?: string;
  containerClass?: string;
  bodyClass?: string;
  headerOverlay?: boolean;
}

const { title, description, keywords, locale = 'en', containerClass, bodyClass, headerOverlay = false } = Astro.props;
const pathname = Astro.url.pathname;
const isHomePage = pathname === `/${locale}` || pathname === `/${locale}/`;
---

<RootLayout
  title={title}
  description={description}
  keywords={keywords}
  locale={locale}
  bodyClass={bodyClass || 'bg-background'}
>
  <div class:list={[
    'min-h-screen flex flex-col text-foreground',
    containerClass || (!isHomePage ? 'bg-[#F7F4F0] dark:bg-[#101010]' : 'bg-background'),
  ]}>
    <header class:list={[
      'w-full z-50',
      headerOverlay ? 'fixed top-0 left-0 right-0 pointer-events-none [&>*]:pointer-events-auto' : 'sticky top-0'
    ]}>
      <StoreHeader client:idle pathname={pathname} locale={locale} />
    </header>
    <main class:list={['flex-1 pb-12 md:pb-6', !isHomePage && 'bg-[#F7F4F0] dark:bg-[#101010]']}>
      <slot />
    </main>
    <StoreFooter client:idle pathname={pathname} locale={locale} />
  </div>
</RootLayout>

