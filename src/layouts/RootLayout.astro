---
import "@/src/styles/globals.css";
import { ClientRouter } from 'astro:transitions';
import { AppToaster } from '@/components/ui/app-toaster';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  locale?: string;
  bodyClass?: string;
}

const {
  title = "Rajalakshmi Fireworks | Premium Crackers & Fireworks",
  description = "Shop premium quality fireworks and crackers online. Wide selection of sparklers, flower pots, rockets, chakras, fountains, and gift boxes. Direct from Sivakasi.",
  keywords = [
    "fireworks",
    "crackers",
    "sparklers",
    "Diwali crackers",
    "Sivakasi fireworks",
    "buy crackers online",
    "flower pots",
    "rockets",
    "gift boxes",
  ],
  locale = "en",
  bodyClass = "bg-background",
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        try {
          var pathname = window.location.pathname;
          var isAdmin = pathname.indexOf("/admin") !== -1;
          if (isAdmin) {
            var adminTheme = localStorage.getItem("admin_theme");
            // Default to dark mode for admin console if not specified
            if (adminTheme === "light") {
              document.documentElement.classList.remove("dark");
              document.documentElement.setAttribute("data-theme", "light");
            } else {
              document.documentElement.classList.add("dark");
              document.documentElement.setAttribute("data-theme", "dark");
            }
          } else {
            var siteTheme = localStorage.getItem("theme");
            if (siteTheme === "dark") {
              document.documentElement.classList.add("dark");
              document.documentElement.setAttribute("data-theme", "dark");
            } else {
              document.documentElement.classList.remove("dark");
              document.documentElement.setAttribute("data-theme", "light");
            }
          }
        } catch (e) {}
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <script is:inline>
      function captureRef() {
        try {
          var params = new URLSearchParams(window.location.search);
          var ref = params.get('ref') || params.get('agent');
          if (ref && ref.trim()) {
            var code = ref.trim().toUpperCase();
            var d = new Date();
            // 30 days attribution window
            d.setTime(d.getTime() + (30 * 24 * 60 * 60 * 1000));
            document.cookie = 'rf_agent_ref=' + encodeURIComponent(code) + '; expires=' + d.toUTCString() + '; path=/; SameSite=Lax';
            try {
              localStorage.setItem('rf_agent_ref', code);
              localStorage.setItem('rf_agent_ref_time', String(Date.now()));
            } catch (e) {}
          }
        } catch (e) {}
      }
      captureRef();
      document.addEventListener("astro:page-load", captureRef);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Rajalakshmi Fireworks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts preload & asynchronous stylesheet (optimized to essential weights) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Noto+Sans+Tamil:wght@400..700&family=Outfit:wght@500..800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Noto+Sans+Tamil:wght@400..700&family=Outfit:wght@500..800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Noto+Sans+Tamil:wght@400..700&family=Outfit:wght@500..800&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body
    class={`${bodyClass} text-foreground min-h-screen flex flex-col font-sans antialiased selection:bg-brand selection:text-brand-foreground`}
  >
    <AppToaster client:idle />
    <slot />
  </body>
</html>
